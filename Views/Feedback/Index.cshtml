@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Home";
}
<section class="hero">
    <p class="eyebrow">STUDENT EXPERIENCE</p>
    <h1>Student Feedback Form</h1>
    <p class="muted">Share your feedback and help us improve the learning experience.</p>
    <div class="actions">
        @Html.ActionLink("Give Feedback", "Create", "feedback", null, new { @class = "button" })
        @Html.ActionLink("View Feedback", "ViewFeedback", "feedback", null, new { @class = "button button-light" })
    </div>
</section>
