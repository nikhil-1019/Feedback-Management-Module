@model feedback1.Models.Feedback
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Give Feedback";
}
<section class="panel">
    <p class="eyebrow">YOUR VOICE MATTERS</p>
    <h1>Give Feedback</h1>
    @using (Html.BeginForm("Create", "feedback", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "Please correct the following:", new { @class = "validation-summary" })
        <div class="field">
            @Html.LabelFor(m => m.StudentName)
            @Html.TextBoxFor(m => m.StudentName, new { placeholder = "Enter your full name" })
            @Html.ValidationMessageFor(m => m.StudentName)
        </div>
        <div class="field">
            @Html.LabelFor(m => m.EnrollmentNo)
            @Html.TextBoxFor(m => m.EnrollmentNo, new { placeholder = "Enter enrollment number" })
            @Html.ValidationMessageFor(m => m.EnrollmentNo)
        </div>
        <div class="field">
            @Html.LabelFor(m => m.Subject)
            @Html.TextBoxFor(m => m.Subject, new { placeholder = "Enter subject name" })
            @Html.ValidationMessageFor(m => m.Subject)
        </div>
        <div class="field">
            @Html.LabelFor(m => m.Rating)
            @Html.DropDownListFor(m => m.Rating, new SelectList(new[] { new { Value = 0, Text = "Select rating" }, new { Value = 1, Text = "1 - Poor" }, new { Value = 2, Text = "2 - Fair" }, new { Value = 3, Text = "3 - Good" }, new { Value = 4, Text = "4 - Very good" }, new { Value = 5, Text = "5 - Excellent" } }, "Value", "Text", Model.Rating), new { })
            @Html.ValidationMessageFor(m => m.Rating)
        </div>
        <div class="field">
            @Html.LabelFor(m => m.Comment)
            @Html.TextAreaFor(m => m.Comment, 4, 40, new { placeholder = "Write your comments..." })
            @Html.ValidationMessageFor(m => m.Comment)
        </div>
        <button class="button" type="submit">Submit Feedback</button>
    }
</section>
